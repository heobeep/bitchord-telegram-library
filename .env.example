# Required database connection (use Render's internal DATABASE_URL in production)
DATABASE_URL=

# Public HTTPS base URL, without a trailing slash
PUBLIC_BASE_URL=https://your-service.example

# Safe defaults: public catalogue and indexing remain OFF until configured and authorised
PUBLIC_CATALOG_ENABLED=false
INDEXING_ENABLED=false
DISTRIBUTION_AUTHORIZED=false

# Telegram central source account. Never commit a real session string.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Comma-separated usernames or numeric peer IDs; only list approved source channels.
TELEGRAM_SOURCE_CHATS=
INDEX_MESSAGE_LIMIT=500
INDEX_INTERVAL_MINUTES=30

# 32+ random bytes, used to sign short-lived playback URLs
STREAM_SIGNING_SECRET=

# Private S3-compatible object storage (e.g. Cloudflare R2 or AWS S3)
# Media is cached here after first play; keep the bucket private.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

PORT=3000
